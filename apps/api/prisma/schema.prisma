generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  STUDENT
  INTERN
  STAFF
  SUPER_ADMIN
}

enum AccountStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  CHECKED_OUT
}

enum FeeStatus {
  DUE
  SENT
  PAID
  PARTIAL
  OVERDUE
  REJECTED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  DONE
  BLOCKED
}

enum TicketKind {
  REPORT
  COMPLAIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChatKind {
  ADMIN
  FEE
  HELP
  TASK
}

enum NotificationType {
  ATTENDANCE
  FEE
  TASK
  GENERAL
  SYSTEM
  CHAT
}

model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  batches   Batch[]
}

model Batch {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  users        User[]
  courses      Course[]
}

model User {
  id             String        @id @default(cuid())
  fullName       String
  email          String        @unique
  passwordHash   String?
  accountType    AccountType
  status         AccountStatus @default(INVITED)
  designation    String?
  phone          String?
  track          String?
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  batchId        String?
  batch          Batch?        @relation(fields: [batchId], references: [id])
  createdById    String?
  createdBy      User?         @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers   User[]        @relation("UserCreatedBy")
  invitedAt      DateTime?
  activatedAt    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  roles              UserRole[]
  invitations        Invitation[]
  enrollments        Enrollment[]
  topicProgress      TopicProgress[]
  attendanceRecords  AttendanceRecord[]
  feeCases           FeeCase[]           @relation("FeeStudent")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  reviewedTasks      Task[]              @relation("TaskReviewer")
  projects           Project[]           @relation("ProjectIntern")
  createdProjects    Project[]           @relation("ProjectCreator")
  tickets            SupportTicket[]
  surveyResponses    SurveyResponse[]
  chatThreads        ChatThread[]        @relation("ChatUser")
  chatMessages       ChatMessage[]
  notifications      AppNotification[]
  feeMessages        FeeMessage[]
  taskMessages       TaskMessage[]
  fcmDevices         FcmDevice[]
  staffSchedule      StaffSchedule?
  paymentSubmissions PaymentSubmission[]  @relation("PaymentSubStudent")
  reviewedPayments   PaymentSubmission[]  @relation("PaymentReviewer")
  attendanceReminders AttendanceReminder[]

  profileImage    String?
  monthlyFee      Int?
  feeStartDate    DateTime?  @db.Date
  feeDueDay       Int        @default(15)
}

model FcmDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Invitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  sentAt      DateTime  @default(now())
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model Course {
  id               String         @id @default(cuid())
  title            String
  category         String
  description      String?
  thumbnailUrl     String?
  durationMonths   Int            @default(3)
  monthlyFee       Int            @default(0)
  totalFee         Int            @default(0)
  installmentFee   Int            @default(0)
  installmentCount Int            @default(2)
  published        Boolean        @default(false)
  startMonth       String?
  rating           Float          @default(4.5)
  batchId          String?
  batch            Batch?         @relation(fields: [batchId], references: [id])
  batchLabel       String?
  categoryId       String?
  categoryRef      CourseCategory? @relation(fields: [categoryId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sections         CourseSection[]
  enrollments      Enrollment[]
  feeCases         FeeCase[]
  attendance       AttendanceRecord[]
  tasks            Task[]
}

model CourseSection {
  id        String        @id @default(cuid())
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int           @default(0)
  topics    CourseTopic[]
}

model CourseTopic {
  id        String          @id @default(cuid())
  sectionId String
  section   CourseSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  minutes   Int             @default(45)
  sortOrder Int             @default(0)
  progress  TopicProgress[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paidAmount Int     @default(0)
  feeStatus FeeStatus @default(DUE)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model TopicProgress {
  id          String      @id @default(cuid())
  userId      String
  topicId     String
  completed   Boolean     @default(false)
  completedAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id])
  date            DateTime         @db.Date
  checkInAt       DateTime?
  checkOutAt      DateTime?
  status          AttendanceStatus @default(PRESENT)
  source          String           @default("APP")
  checkInLat      Float?
  checkInLng      Float?
  checkInDistance Float?
  autoCheckout    Boolean          @default(false)
  shiftStart      String?
  shiftEnd        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, date])
  @@index([date])
}

model FeeCase {
  id         String       @id @default(cuid())
  studentId  String
  student    User         @relation("FeeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?      @relation(fields: [courseId], references: [id])
  courseTitle String
  month      String
  amount     Int
  status     FeeStatus    @default(DUE)
  dueDate    DateTime
  monthlyFee       Int?
  billingStart     DateTime?  @db.Date
  dueDay           Int        @default(15)
  paymentScreenshotData String?
  paymentSubmittedAt     DateTime?
  rejectionReason        String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  messages   FeeMessage[]
  submissions PaymentSubmission[]
}

model FeeMessage {
  id            String   @id @default(cuid())
  feeCaseId     String
  feeCase       FeeCase  @relation(fields: [feeCaseId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?    @relation(fields: [senderId], references: [id])
  senderName    String
  senderRole    String
  text          String
  hasScreenshot Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Task {
  id            String        @id @default(cuid())
  title         String
  description   String?
  studyNotes    String?
  audience      AccountType   @default(STAFF)
  status        TaskStatus    @default(ASSIGNED)
  dueAt         DateTime?
  timerMinutes  Int           @default(0)
  spentMinutes  Int           @default(0)
  assigneeId    String?
  assignee      User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById   String?
  createdBy     User?         @relation("TaskCreator", fields: [createdById], references: [id])
  reviewerId    String?
  reviewer      User?         @relation("TaskReviewer", fields: [reviewerId], references: [id])
  courseId      String?
  course        Course?       @relation(fields: [courseId], references: [id])
  submissionText     String?
  submissionFileData String?
  submissionFileName String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  feedback           String?
  reviewStatus       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      TaskMessage[]
}

model TaskMessage {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id])
  senderName String
  senderRole String
  text       String
  createdAt  DateTime @default(now())
}

model Project {
  id              String     @id @default(cuid())
  title           String
  description     String?
  techStack       String?
  repoUrl         String?
  status          TaskStatus @default(ASSIGNED)
  deadline        DateTime?
  progressPercent Int        @default(0)
  internId        String
  intern          User       @relation("ProjectIntern", fields: [internId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?      @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model SupportTicket {
  id        String       @id @default(cuid())
  kind      TicketKind
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Survey {
  id          String           @id @default(cuid())
  title       String
  description String?
  active      Boolean          @default(true)
  questions   Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  responses   SurveyResponse[]
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     Json
  submittedAt DateTime @default(now())

  @@unique([surveyId, userId])
}

model ChatThread {
  id            String        @id @default(cuid())
  kind          ChatKind      @default(ADMIN)
  userId        String
  user          User          @relation("ChatUser", fields: [userId], references: [id], onDelete: Cascade)
  lastMessage   String?
  unreadByAdmin Int           @default(0)
  unreadByUser  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]

  @@index([userId, kind])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?      @relation(fields: [senderId], references: [id])
  senderName String
  senderRole String
  text       String
  createdAt  DateTime   @default(now())
}

model AppNotification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  /// Extra payload for deep-link / UI (JSON object as string keys)
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model AppVersion {
  id               Int      @id @default(1)
  minVersion       String   @default("1.0.0")
  latestVersion    String   @default("1.0.0")
  forceUpdate      Boolean  @default(false)
  storeUrlAndroid  String?
  message          String?
  updatedAt        DateTime @updatedAt
}

model PaymentInfo {
  id          Int      @id @default(1)
  adminName   String
  phone       String
  jazzCash    String?
  easyPaisa   String?
  bankTitle   String?
  bankAccount String?
  updatedAt   DateTime @updatedAt
}

model OfficeConfig {
  id           Int      @id @default(1)
  latitude     Float    @default(29.3931779)
  longitude    Float    @default(71.6924333)
  radiusMeters Int      @default(100)
  timezone     String   @default("Asia/Karachi")
  updatedAt    DateTime @updatedAt
}

model StaffSchedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime String   @default("08:00")
  endTime   String   @default("17:00")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}

model PaymentSubmission {
  id             String   @id @default(cuid())
  feeCaseId      String
  feeCase        FeeCase  @relation(fields: [feeCaseId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation("PaymentSubStudent", fields: [studentId], references: [id], onDelete: Cascade)
  amount         Int
  screenshotData String?
  screenshotName String?
  status         String   @default("PENDING_VERIFICATION")
  rejectionReason String?
  reviewedById   String?
  reviewedBy     User?    @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([feeCaseId])
  @@index([studentId])
}

model AttendanceReminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}
