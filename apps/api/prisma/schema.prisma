generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  STUDENT
  INTERN
  STAFF
  SUPER_ADMIN
}

enum AccountStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  CHECKED_OUT
  LEAVE
}

enum FeeStatus {
  DUE
  SENT
  PAID
  PARTIAL
  OVERDUE
  REJECTED
  WAIVED
}

enum PaymentPlanType {
  MONTHLY
  TWO_INSTALLMENTS
  CUSTOM
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  DONE
  BLOCKED
}

enum EnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketKind {
  REPORT
  COMPLAIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChatKind {
  ADMIN
  FEE
  HELP
  TASK
}

enum NotificationType {
  ATTENDANCE
  FEE
  TASK
  GENERAL
  SYSTEM
  CHAT
  CERTIFICATE
  QUIZ
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  batches   Batch[]
}

model Batch {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  users        User[]
  courses      Course[]
}

model User {
  id             String        @id @default(cuid())
  fullName       String
  email          String        @unique
  passwordHash   String?
  accountType    AccountType
  status         AccountStatus @default(INVITED)
  designation    String?
  /** Staff/instructor years or experience blurb (e.g. "5 years"). */
  experience     String?
  /** Optional instructor / staff profile text. */
  bio            String?
  phone          String?
  track          String?
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  batchId        String?
  batch          Batch?        @relation(fields: [batchId], references: [id])
  createdById    String?
  createdBy      User?         @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers   User[]        @relation("UserCreatedBy")
  invitedAt      DateTime?
  activatedAt    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  roles              UserRole[]
  invitations        Invitation[]
  passwordResets     PasswordResetToken[]
  refreshTokens      RefreshToken[]
  enrollments        Enrollment[]
  topicProgress      TopicProgress[]
  attendanceRecords  AttendanceRecord[]
  feeCases           FeeCase[]           @relation("FeeStudent")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  reviewedTasks      Task[]              @relation("TaskReviewer")
  projects           Project[]           @relation("ProjectIntern")
  createdProjects    Project[]           @relation("ProjectCreator")
  tickets            SupportTicket[]
  surveyResponses    SurveyResponse[]
  chatThreads        ChatThread[]        @relation("ChatUser")
  chatMessages       ChatMessage[]
  notifications      AppNotification[]
  feeMessages        FeeMessage[]
  taskMessages       TaskMessage[]
  fcmDevices         FcmDevice[]
  staffSchedule      StaffSchedule?
  paymentSubmissions PaymentSubmission[]  @relation("PaymentSubStudent")
  reviewedPayments   PaymentSubmission[]  @relation("PaymentReviewer")
  attendanceReminders AttendanceReminder[]
  enrollmentRequests  EnrollmentRequest[] @relation("EnrollmentRequester")
  reviewedEnrollments EnrollmentRequest[] @relation("EnrollmentReviewer")
  instructedCourses   Course[]            @relation("CourseInstructor")
  createdQuizzes      Quiz[]              @relation("QuizCreator")
  quizAttempts        QuizAttempt[]
  certificates        Certificate[]
  aiMessages          AiMessage[]
  aiUsageLogs         AiUsageLog[]
  leaveRequests       LeaveRequest[]       @relation("LeaveStudent")
  reviewedLeaves      LeaveRequest[]       @relation("LeaveReviewer")

  profileImage    String?
  monthlyFee      Int?
  feeStartDate    DateTime?  @db.Date
  feeDueDay       Int        @default(15)
  /** Student payment plan (optional). */
  paymentType           PaymentPlanType?
  installment1Amount    Int?
  installment2Amount    Int?
  courseDurationMonths  Int?
  totalCourseFee        Int?
  /** Intern program window (optional). */
  internshipStart DateTime?  @db.Date
  internshipEnd   DateTime?  @db.Date
}

model FcmDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Invitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  sentAt      DateTime  @default(now())
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Course {
  id               String         @id @default(cuid())
  title            String
  category         String
  description      String?
  thumbnailUrl     String?
  durationMonths   Int            @default(3)
  monthlyFee       Int            @default(0)
  totalFee         Int            @default(0)
  installmentFee   Int            @default(0)
  installmentCount Int            @default(2)
  published        Boolean        @default(false)
  /** When true, students may submit enrollment requests (admin must approve). */
  allowEnrollmentRequests Boolean  @default(false)
  startMonth       String?
  rating           Float          @default(4.5)
  batchId          String?
  batch            Batch?         @relation(fields: [batchId], references: [id])
  batchLabel       String?
  categoryId       String?
  categoryRef      CourseCategory? @relation(fields: [categoryId], references: [id])
  instructorId     String?
  instructor       User?          @relation("CourseInstructor", fields: [instructorId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sections         CourseSection[]
  enrollments      Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  feeCases         FeeCase[]
  attendance       AttendanceRecord[]
  tasks            Task[]
  quizzes          Quiz[]
  certificates     Certificate[]
}

model EnrollmentRequest {
  id           String                  @id @default(cuid())
  userId       String
  courseId     String
  status       EnrollmentRequestStatus @default(PENDING)
  note         String?
  adminNote    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  user         User                    @relation("EnrollmentRequester", fields: [userId], references: [id], onDelete: Cascade)
  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewedBy   User?                   @relation("EnrollmentReviewer", fields: [reviewedById], references: [id])

  @@unique([userId, courseId])
  @@index([status])
  @@index([courseId])
}

model CourseSection {
  id        String        @id @default(cuid())
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int           @default(0)
  topics    CourseTopic[]
}

model CourseTopic {
  id        String          @id @default(cuid())
  sectionId String
  section   CourseSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  minutes   Int             @default(45)
  sortOrder Int             @default(0)
  progress  TopicProgress[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paidAmount Int     @default(0)
  feeStatus FeeStatus @default(DUE)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model TopicProgress {
  id          String      @id @default(cuid())
  userId      String
  topicId     String
  completed   Boolean     @default(false)
  completedAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id])
  date            DateTime         @db.Date
  checkInAt       DateTime?
  checkOutAt      DateTime?
  status          AttendanceStatus @default(PRESENT)
  source          String           @default("APP")
  checkInLat      Float?
  checkInLng      Float?
  checkInDistance Float?
  autoCheckout    Boolean          @default(false)
  shiftStart      String?
  shiftEnd        String?
  /// Last time verify-location confirmed inside geofence.
  lastInsideAt    DateTime?
  /// First time verify-location confirmed outside while session open.
  outsideSince    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, date])
  @@index([date])
}

model FeeCase {
  id         String       @id @default(cuid())
  studentId  String
  student    User         @relation("FeeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?      @relation(fields: [courseId], references: [id])
  courseTitle String
  month      String
  amount     Int
  status     FeeStatus    @default(DUE)
  dueDate    DateTime
  monthlyFee       Int?
  billingStart     DateTime?  @db.Date
  dueDay           Int        @default(15)
  amountPaid       Int        @default(0)
  paymentScreenshotData String?
  paymentSubmittedAt     DateTime?
  rejectionReason        String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  messages   FeeMessage[]
  submissions PaymentSubmission[]
  reminderLogs FeeReminderLog[]
}

/** Tracks fee reminder sends so cron never duplicates FIRST/FINAL per case. */
model FeeReminderLog {
  id        String   @id @default(cuid())
  feeCaseId String
  feeCase   FeeCase  @relation(fields: [feeCaseId], references: [id], onDelete: Cascade)
  kind      String
  sentAt    DateTime @default(now())

  @@unique([feeCaseId, kind])
  @@index([sentAt])
}

model FeeMessage {
  id            String   @id @default(cuid())
  feeCaseId     String
  feeCase       FeeCase  @relation(fields: [feeCaseId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?    @relation(fields: [senderId], references: [id])
  senderName    String
  senderRole    String
  text          String
  hasScreenshot Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Task {
  id            String        @id @default(cuid())
  title         String
  description   String?
  studyNotes    String?
  audience      AccountType   @default(STAFF)
  status        TaskStatus    @default(ASSIGNED)
  dueAt         DateTime?
  timerMinutes  Int           @default(0)
  spentMinutes  Int           @default(0)
  assigneeId    String?
  assignee      User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById   String?
  createdBy     User?         @relation("TaskCreator", fields: [createdById], references: [id])
  reviewerId    String?
  reviewer      User?         @relation("TaskReviewer", fields: [reviewerId], references: [id])
  courseId      String?
  course        Course?       @relation(fields: [courseId], references: [id])
  submissionText     String?
  submissionFileData String?
  submissionFileName String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  feedback           String?
  reviewStatus       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      TaskMessage[]
}

model TaskMessage {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id])
  senderName String
  senderRole String
  text       String
  createdAt  DateTime @default(now())
}

model Project {
  id              String     @id @default(cuid())
  title           String
  description     String?
  techStack       String?
  repoUrl         String?
  status          TaskStatus @default(ASSIGNED)
  deadline        DateTime?
  progressPercent Int        @default(0)
  internId        String
  intern          User       @relation("ProjectIntern", fields: [internId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?      @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model SupportTicket {
  id        String       @id @default(cuid())
  kind      TicketKind
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Survey {
  id          String           @id @default(cuid())
  title       String
  description String?
  active      Boolean          @default(true)
  questions   Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  responses   SurveyResponse[]
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     Json
  submittedAt DateTime @default(now())

  @@unique([surveyId, userId])
}

model ChatThread {
  id            String        @id @default(cuid())
  kind          ChatKind      @default(ADMIN)
  userId        String
  user          User          @relation("ChatUser", fields: [userId], references: [id], onDelete: Cascade)
  lastMessage   String?
  unreadByAdmin Int           @default(0)
  unreadByUser  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]

  @@index([userId, kind])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?      @relation(fields: [senderId], references: [id])
  senderName String
  senderRole String
  text       String     @default("")
  /// Optional image attachment (data URL or base64) for chat media.
  imageData  String?
  imageName  String?
  /// USER→ADMIN: delivered when admin opens the thread; seen when admin reads.
  deliveredAt DateTime?
  seenAt      DateTime?
  createdAt  DateTime   @default(now())
}

model AppNotification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  /// Extra payload for deep-link / UI (JSON object as string keys)
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model AppVersion {
  id               Int      @id @default(1)
  minVersion       String   @default("1.0.0")
  latestVersion    String   @default("1.0.0")
  forceUpdate      Boolean  @default(false)
  storeUrlAndroid  String?
  message          String?
  updatedAt        DateTime @updatedAt
}

model PaymentInfo {
  id          Int      @id @default(1)
  adminName   String
  phone       String
  jazzCash    String?
  easyPaisa   String?
  bankTitle   String?
  bankAccount String?
  updatedAt   DateTime @updatedAt
}

model OfficeConfig {
  id                Int      @id @default(1)
  /// Port Singer / Gohe Tone office — keep static unless admin overrides.
  latitude          Float    @default(29.3931779)
  longitude         Float    @default(71.6924333)
  radiusMeters      Int      @default(50)
  timezone          String   @default("Asia/Karachi")
  studentStartTime  String   @default("09:00")
  studentEndTime    String   @default("14:00")
  /// Default staff shift: 10:00–18:00 (8h), Sun–Fri.
  staffStartTime    String   @default("10:00")
  staffEndTime      String   @default("18:00")
  internStartTime   String   @default("10:00")
  internEndTime     String   @default("18:00")
  /// JS getDay() list: 0=Sun … 6=Sat. Default Sun–Fri.
  staffWorkingDays  String   @default("0,1,2,3,4,5")
  staffOffDays      String   @default("6")
  exitGraceMinutes  Int      @default(2)
  updatedAt         DateTime @updatedAt
}

model OfficeHoliday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  label     String
  createdAt DateTime @default(now())
}

model StaffSchedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime String   @default("10:00")
  endTime   String   @default("18:00")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}

model PaymentSubmission {
  id             String   @id @default(cuid())
  feeCaseId      String
  feeCase        FeeCase  @relation(fields: [feeCaseId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation("PaymentSubStudent", fields: [studentId], references: [id], onDelete: Cascade)
  amount         Int
  screenshotData String?
  screenshotName String?
  status         String   @default("PENDING_VERIFICATION")
  rejectionReason String?
  reviewedById   String?
  reviewedBy     User?    @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([feeCaseId])
  @@index([studentId])
}

model AttendanceReminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

/** MCQ quiz tied to a course. Graded only on the server. */
model Quiz {
  id                String           @id @default(cuid())
  courseId          String
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  status            QuizStatus       @default(DRAFT)
  passPercent       Int              @default(70)
  timeLimitMinutes  Int?
  shuffleQuestions  Boolean          @default(false)
  maxAttempts       Int              @default(3)
  issueCertificate  Boolean          @default(true)
  createdById       String?
  createdBy         User?            @relation("QuizCreator", fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  questions         QuizQuestion[]
  attempts          QuizAttempt[]
  certificates      Certificate[]

  @@index([courseId])
  @@index([status])
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt       String
  /** JSON string array of options, e.g. ["A","B","C","D"] */
  options      Json
  correctIndex Int
  points       Int    @default(1)
  sortOrder    Int    @default(0)

  @@index([quizId])
}

model QuizAttempt {
  id          String            @id @default(cuid())
  quizId      String
  quiz        Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      QuizAttemptStatus @default(IN_PROGRESS)
  /** Map questionId -> selectedIndex */
  answers     Json?
  score       Int               @default(0)
  maxScore    Int               @default(0)
  percent     Float             @default(0)
  passed      Boolean           @default(false)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([quizId, userId])
  @@index([userId])
}

/** Verifiable course/quiz certificate. */
model Certificate {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String?
  course             Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  quizId             String?
  quiz               Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)
  title              String
  recipientName      String
  courseTitle        String?
  verificationCode   String   @unique
  issuedAt           DateTime @default(now())
  meta               Json?
  createdAt          DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([verificationCode])
}

/** AI study coach conversation turn (user or assistant). */
model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  courseId  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  model        String?
  promptTokens Int      @default(0)
  completionTokens Int  @default(0)
  ok           Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/** Student leave request — 2 days allowance per calendar month (server-enforced). */
model LeaveRequest {
  id              String      @id @default(cuid())
  studentId       String
  student         User        @relation("LeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  leaveDate       DateTime    @db.Date
  durationDays    Float
  reason          String
  status          LeaveStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([studentId, leaveDate])
  @@index([status, createdAt])
  @@index([studentId, status])
}
