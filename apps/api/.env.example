DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
# Firebase Admin JSON as a single-line string (Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=
JWT_SECRET="change-me"
# Access token lifetime (Phase B default: 12h). Refresh tokens last REFRESH_TOKEN_DAYS.
JWT_EXPIRES_IN="12h"
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_TTL_HOURS=2
# Protect POST /ops/cron/* for Render Cron Jobs
CRON_SECRET="change-me-cron"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
# Comma-separated browser origins for CORS (admin dashboard). Mobile apps need no Origin.
# Example prod: https://your-admin.vercel.app,http://localhost:3000
CORS_ORIGIN="http://localhost:3000"

# AI Study Coach (optional). Without AI_API_KEY the app uses a local LMS coach.
AI_API_KEY=
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_DAILY_LIMIT_PER_USER=40

INVITATION_TTL_HOURS=24
MAIL_FROM_NAME="Codes Thinker Software House"
MAIL_FROM_EMAIL="noreply@codesthinker.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
PORT=4000
SEED_ADMIN_EMAIL="ayaz@codesthinker.com"
SEED_ADMIN_PASSWORD="Admin@CodesThinker1"
SEED_ADMIN_NAME="Ayaz Aslam"
